# --- Web-Stack configuration -------------------------------------------------
# API key POOLS (comma-separated). The built-in relay injects the active key and
# rotates automatically on 401/403/429. Add as many keys as you like.
TAVILY_API_KEYS=key1,key2
FIRECRAWL_API_KEYS=key1,key2
CONTEXT7_API_KEYS=key1,key2
# Auth tokens for the browser upstreams (any long random string).
STEALTH_BROWSER_MCP_AUTH_TOKEN=change-me
SCRAPLING_MCP_AUTH_TOKEN=change-me
